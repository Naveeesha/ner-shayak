# =============================================================================
# NER-Sahayak Backend Environment Configuration
# =============================================================================

PORT=4000
JWT_SECRET=ner-sahayak-jwt-super-secret-key-2026

# Supabase PostgreSQL Configuration (Backend Service Role)
# IMPORTANT: Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend / React application.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Supabase Anon Key (for public client reads if needed)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Optional AI / OpenAI integration for Ask Sahayak
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MSG91 Real SMS Configuration
# Set MSG91_ENABLED=true to enable real SMS delivery over MSG91 Flow API.
# Keep SMS_TEST_MODE=true for local mock logging ([SMS TEST] recipient: 98******10 ...)
MSG91_ENABLED=false
SMS_TEST_MODE=true
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_FLOW_ID=your_msg91_flow_or_template_id_here
MSG91_SENDER_ID=SAHYAK
